# ==============================================================================
# Harry Potter Autonomous Shorts Pipeline — Environment Variables Template
# ACCOUNT: jishanh760@gmail.com  |  COMPLETELY ISOLATED FROM AL AMR
# ==============================================================================
# Copy this file to .env and fill in your genuine credentials.
# NEVER commit the real .env file or real secrets to git.
# .env is in .gitignore — it will never be committed.

# ------------------------------------------------------------------------------
# 1. CHANNEL & CONTENT SPECIFICATION
# ------------------------------------------------------------------------------
NICHE=Harry Potter
DEFAULT_LANGUAGE=en

# ------------------------------------------------------------------------------
# 2. SYSTEM & OPERATION MODES
# ------------------------------------------------------------------------------
TEST_MODE=true
CLOUD_MODE=false
PORT=8001

# ------------------------------------------------------------------------------
# 3. PUBLISHING SAFETY — HARD GATE
# Both must be true to allow any YouTube upload.
# These remain false until the explicit launch step is authorized.
# ------------------------------------------------------------------------------
PUBLISHING_ENABLED=false
UPLOAD_ENABLED=false

# ------------------------------------------------------------------------------
# 4. PUBLISHING SCHEDULE & CONTENT ALLOCATION
# ------------------------------------------------------------------------------
SHORTS_PER_DAY=4
NOVEL_SHORTS_PER_DAY=2
DISCOVERY_SHORTS_PER_DAY=2
TARGET_RESERVE_BUFFER=8
SCHEDULING_HORIZON_HOURS=48
PUBLISHING_PLATFORMS=youtube

# ------------------------------------------------------------------------------
# 5. VISUAL SOURCE PRIORITY
# MOVIE FOOTAGE IS ALWAYS ATTEMPT #1 FOR EACH VISUAL BEAT.
# Images/AI/stock are per-beat fallbacks only when no suitable movie clip found.
# ------------------------------------------------------------------------------
VISUAL_SOURCE_PRIORITY=movie_footage,book_imagery,ai_generated,stock_footage,pexels
PART_MARKER_ENABLED=true
PART_MARKER_FORMAT=PART {:02d}

# ------------------------------------------------------------------------------
# 6. VOICE & NARRATION — Andrew Hype (PERMANENT — DO NOT CHANGE)
# ------------------------------------------------------------------------------
TTS_PROVIDER=edge
KOKORO_VOICE=en-US-AndrewNeural
ACTIVE_VOICE_PITCH=+24Hz
ACTIVE_VOICE_RATE=+14%

# ------------------------------------------------------------------------------
# 7. IMAGE GENERATION — NVIDIA primary, Pollinations fallback
# ------------------------------------------------------------------------------
IMAGE_PROVIDER=nvidia
NVIDIA_IMAGE_MODEL=nvidia/consistory

# ------------------------------------------------------------------------------
# 8. GOOGLE DRIVE VAULT (jishanh760@gmail.com ONLY — Harry Potter vault)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_VAULT_ROOT=Harry_Potter_Shorts_Vault

# ------------------------------------------------------------------------------
# 9. AI PROVIDERS (Supply your OWN dedicated Harry Potter project keys)
#    NEVER reuse AL AMR keys.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_fresh_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 10. YOUTUBE OAUTH — Harry Potter channel ONLY (jishanh760@gmail.com)
#
#  CREDENTIAL FILES (both are gitignored — never committed):
#    credentials/hp_client_secret.json   ← place your OAuth client secret here
#    credentials/hp_token.json           ← auto-generated by scripts/auth_google.py
#
#  HOW TO AUTHENTICATE:
#    1. Create OAuth 2.0 credentials in Google Cloud Console (jishanh760 project)
#    2. Download JSON → rename to hp_client_secret.json → place in credentials/
#    3. Run: python scripts/auth_google.py
#    4. Authorize jishanh760@gmail.com in the browser
#    5. The script will detect & write your channel ID below automatically.
# ------------------------------------------------------------------------------
TOKEN_PATH=credentials/hp_token.json
CLIENT_SECRETS_PATH=credentials/hp_client_secret.json

# Harry Potter YouTube Channel Identity (filled automatically by auth_google.py)
HP_YOUTUBE_CHANNEL_ID=
HP_YOUTUBE_CHANNEL_NAME=

# Legacy env-var fields (for cloud deployment compatibility)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 11. GITHUB DISPATCHER — Harry Potter repo only
# ------------------------------------------------------------------------------
GITHUB_PAT=
GITHUB_REPOSITORY_OWNER=jishanh760-source
GITHUB_REPOSITORY_NAME=harry-potter-automation
GITHUB_REF=main
