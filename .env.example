# ==============================================================================
# Harry Potter Autonomous Shorts Pipeline - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your genuine credentials.
# NEVER commit the real .env file or real secrets to git.

# ------------------------------------------------------------------------------
# 1. CHANNEL & CONTENT SPECIFICATION
# ------------------------------------------------------------------------------
NICHE=Harry Potter
DEFAULT_LANGUAGE=en

# ------------------------------------------------------------------------------
# 2. SYSTEM & OPERATION MODES
# ------------------------------------------------------------------------------
TEST_MODE=true
CLOUD_MODE=false
PORT=8001

# ------------------------------------------------------------------------------
# 3. PUBLISHING SCHEDULE & CONTENT ALLOCATION
# ------------------------------------------------------------------------------
SHORTS_PER_DAY=4
NOVEL_SHORTS_PER_DAY=2
DISCOVERY_SHORTS_PER_DAY=2
TARGET_RESERVE_BUFFER=8
SCHEDULING_HORIZON_HOURS=48
PUBLISHING_PLATFORMS=youtube,instagram,facebook

# ------------------------------------------------------------------------------
# 4. VISUAL SOURCES & PART MARKER
# ------------------------------------------------------------------------------
VISUAL_SOURCE_PRIORITY=movie_footage,book_imagery,ai_generated,stock_footage,pexels
PART_MARKER_ENABLED=true
PART_MARKER_FORMAT=PART {:02d}

# ------------------------------------------------------------------------------
# 5. VOICE & NARRATION (Kokoro TTS / Bella Profile)
# ------------------------------------------------------------------------------
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_bella
BELLA_VOICE_PROFILE=BELLA_CINEMATIC

# ------------------------------------------------------------------------------
# 6. AI PROVIDERS & EXTERNAL APIS (Supply your own dedicated keys)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 7. GOOGLE CLOUD / YOUTUBE / DRIVE OAUTH CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_VAULT_ROOT=Harry_Potter_Shorts_Vault
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TOKEN_JSON=
CLIENT_SECRET_JSON=

# ------------------------------------------------------------------------------
# 8. GITHUB DISPATCHER CONFIGURATION
# ------------------------------------------------------------------------------
GITHUB_PAT=
GITHUB_REPOSITORY_OWNER=jishanh760-source
GITHUB_REPOSITORY_NAME=harry-potter-automation
GITHUB_REF=main
