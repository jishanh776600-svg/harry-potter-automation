# Python
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/

# ==============================================================================
# CREDENTIALS & SECRETS — ALL GITIGNORED — NEVER COMMIT
# Harry Potter project uses: credentials/hp_token.json + credentials/hp_client_secret.json
# ==============================================================================
# OAuth tokens (all patterns)
token.json
hp_token.json
*_token.json
credentials/hp_token.json
credentials/*.json

# OAuth client secrets (all patterns)
client_secret.json
hp_client_secret.json
*client_secret*.json
credentials/hp_client_secret.json

# Environment secrets
.env
.env.local
.env.production
show_secrets.py

# API key files
*.key
*.pem
*.p12

# Google service account credentials
service_account*.json
gcp_credentials*.json

# ==============================================================================
# LARGE MODEL WEIGHTS (Downloaded on-the-fly by Kokoro / HF)
# ==============================================================================
data/*.onnx
data/*.bin
*.onnx
*.bin

# Media Caches & Local Derived Copies (Drive is authoritative cloud vault)
data/renders/
data/voice/
data/visuals/
data/assets/
data/captions/
data/vault_ready/
data/books/
!data/books/.gitkeep
data/movies/
!data/movies/.gitkeep
data/movie_subtitles/
!data/movie_subtitles/.gitkeep
data/clips/
!data/clips/.gitkeep

# Temporary test audio and logs
*.log
stage_*.wav
test_*.wav
test_*.aac
*.mp4
*.db-shm
*.db-wal

# Database (Persisted Privately in Google Drive 00_SYSTEM/ - Never tracked in Git)
data/database/pipeline.db
data/database/*.db*
data/database/*
!data/database/.gitkeep
*.db
*.db-*
*.prev_backup

# Keep empty structure
!data/database/.gitkeep
!assets/music/*.wav
!assets/music/*.mp3
!credentials/.gitkeep

# Runtime locks & temporary cache
data/locks/
data/cache/
.agents/
scratch_*
crop_*.png
data/matrix_frames/
data/timecode_audit/
data/voice_audition/
data/auditions/*.wav
data/auditions/*.mp3
data/subtitles/
data/validation_frames/
data/test_inspect_frames/
